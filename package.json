{
  "name": "@tuteliq/react-native",
  "version": "3.0.0",
  "description": "Official React Native SDK for Tuteliq - AI-powered child safety API",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/ __tests__/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "pretest": "npm run build",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "tuteliq",
    "react-native",
    "child-safety",
    "content-moderation",
    "bullying-detection",
    "grooming-detection",
    "ai",
    "sdk",
    "parental-control",
    "online-safety",
    "mobile"
  ],
  "author": "Tuteliq <sales@tuteliq.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tuteliq/react-native.git"
  },
  "homepage": "https://tuteliq.ai",
  "bugs": {
    "url": "https://github.com/Tuteliq/react-native/issues"
  },
  "dependencies": {
    "@tuteliq/sdk": "^3.2.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-native": ">=0.70.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.9.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.3.1",
    "react-native": "^0.88.0",
    "ts-jest": "^29.4.15",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
